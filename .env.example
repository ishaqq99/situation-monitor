# Copy this file to .env in the project root and choose local development values.
POSTGRES_DB=situation_monitor
POSTGRES_USER=situation_monitor
POSTGRES_PASSWORD=change_me

# Keep credentials aligned with the values above; URL-encode special characters.
DATABASE_URL=postgresql://situation_monitor:change_me@127.0.0.1:5432/situation_monitor
REDIS_URL=redis://127.0.0.1:6379/0

# CISA KEV refresh cadence.
KEV_REFRESH_INTERVAL_SECONDS=1800

# FIRST EPSS refresh cadence.
EPSS_REFRESH_INTERVAL_SECONDS=86400
EPSS_STARTUP_DELAY_SECONDS=60
EPSS_RETRY_INTERVAL_SECONDS=300

# NVD is KEV-centered: only KEVs missing/stale NVD enrichment are requested.
# A free NVD API key is optional but strongly recommended for the initial
# backfill because keyed requests have a higher provider rate limit.
NVD_API_KEY=

# Maximum CVEs processed by one manual/scheduled NVD refresh batch.
NVD_BATCH_SIZE=25

# Re-check stored NVD data after seven days by default so CVSS reassessments
# can be detected without re-querying every KEV every day.
NVD_STALE_AFTER_HOURS=168

# Worker timing: startup delay, fast continuation while backlog exists, normal
# caught-up check cadence, and retry delay after a transient failure.
NVD_STARTUP_DELAY_SECONDS=120
NVD_BACKLOG_RETRY_INTERVAL_SECONDS=60
NVD_IDLE_CHECK_INTERVAL_SECONDS=3600
NVD_RETRY_INTERVAL_SECONDS=300

# Request spacing is chosen automatically when omitted:
# - about 6.5 seconds without NVD_API_KEY
# - about 0.75 seconds with NVD_API_KEY
# Uncomment only if you intentionally want to override the default.
# NVD_REQUEST_DELAY_SECONDS=6.5

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
