# Copy to .env.production on the VPS. Never commit or upload the filled file.
# Generate one URL-safe password with: openssl rand -hex 24
POSTGRES_DB=situation_monitor
POSTGRES_USER=situation
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX

# Obtain this from Cloudflare Zero Trust > Networks > Tunnels > your tunnel.
# Store the token here, not in Git or the frontend build.
TUNNEL_TOKEN=REPLACE_WITH_YOUR_TUNNEL_TOKEN

# Optional enrichment credentials. Leave blank if unavailable.
NVD_API_KEY=
OTX_API_KEY=
OTX_ENABLED=false
